<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgRoundabout"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="Hình minh họa vòng xuyến"
            android:scaleType="centerCrop"
            android:src="@drawable/img_roundabout" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Quy tắc nhường đường tại vòng xuyến"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Khi đi vào vòng xuyến, người điều khiển phương tiện cần chú ý nhường đường đúng quy tắc."
            android:textColor="#64748B"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuiz"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Làm quiz"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#22C1E8"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>